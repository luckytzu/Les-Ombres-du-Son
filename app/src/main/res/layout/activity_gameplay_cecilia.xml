<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fond_app"
    tools:context="fr.upjv.lesombresduson.Home">

    <!-- 1. Bouton Retour -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_back"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:text="Retour"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        app:backgroundTint="#BA1A1A"
        app:cornerRadius="10dp"
        app:strokeColor="#FFFFFF"
        app:strokeWidth="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. Logo de l'application -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="140dp"
        android:layout_height="131dp"
        android:layout_marginTop="32dp"
        android:contentDescription="Logo Les Ombres du Son"
        android:src="@drawable/logo_app"
        app:layout_constraintDimensionRatio="1.5:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button_back"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.6" />

    <!-- 3. Image du personnage Cécilia -->
    <ImageView
        android:id="@+id/image_cecilia"
        android:layout_width="328dp"
        android:layout_height="378dp"
        android:contentDescription="Personnage Cécilia (cécité totale)"
        android:src="@drawable/cecilia"
        app:layout_constraintDimensionRatio="262:287"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:layout_constraintWidth_percent="0.7" />

    <!-- 4. Nom du personnage -->
    <TextView
        android:id="@+id/text_cecilia_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cécilia (cécité totale)"
        android:textColor="@android:color/white"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/image_cecilia"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
