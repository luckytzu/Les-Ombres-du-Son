<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_lum"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fond_app"
    tools:context="fr.upjv.lesombresduson.ui.Home">

    <!-- 1. Bouton Retour -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_back"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:text="Retour"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        app:backgroundTint="#BA1A1A"
        app:cornerRadius="10dp"
        app:strokeColor="#FFFFFF"
        app:strokeWidth="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. Logo de l'application -->
    <ImageView
        android:id="@+id/logo_lum"
        android:layout_width="260dp"
        android:layout_height="135dp"
        android:layout_marginTop="32dp"
        android:contentDescription="Logo Les Ombres du Son"
        android:src="@drawable/logo_app"
        app:layout_constraintDimensionRatio="1.5:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button_back"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.6" />

    <!-- 3. Container pour l'image du personnage et overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lum_image_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/logo_lum"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.7"
        app:layout_constraintDimensionRatio="262:287">

        <!-- Image du personnage Lum -->
        <ImageView
            android:id="@+id/image_lum"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Personnage Lum (cécité partielle)"
            android:src="@drawable/lum"
            android:scaleType="centerCrop" />

        <!-- Overlay caméra temps réel -->
        <ImageView
            android:id="@+id/camera_realtime_circle"
            android:layout_width="268dp"
            android:layout_height="278dp"
            android:background="@drawable/circle_background"
            android:contentDescription="Appareil photo en temps réel"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.512"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.285"
            app:tint="@android:color/white" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 4. Nom du personnage -->
    <TextView
        android:id="@+id/text_lum_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lum (cécité partielle)"
        android:textColor="@android:color/white"
        android:textSize="36sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/lum_image_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
